# TechCorp Enterprise AI Platform — environment template
# Copy to .env and fill in the secrets:  cp .env.example .env

# ── LLM (DeepSeek, OpenAI-compatible) ───────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=techcorp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techcorp_enterprise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Qdrant (RAG vector store) ───────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base

# ── RAG pipeline ────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
SPARSE_MODEL=prithivida/Splade_PP_en_v1
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
HYBRID_ALPHA=0.7
RERANK_TOP_K_INITIAL=20

# ── Web search ──────────────────────────────────────────
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# ── Server ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000